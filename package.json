{
  "name": "techcrema",
  "version": "1.2.7",
  "private": true,
  "description": "Your own daily tech front page: popular stories from Hacker News, Hatena Bookmark, dev.to and more, filtered to your interests, published to GitHub Pages by a GitHub Action",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#e2e/*": "./e2e/*",
    "#test/*": "./test/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "node src/bin.ts collect",
    "build": "node src/bin.ts build",
    "update": "npm run collect && npm run build",
    "preview": "node src/bin.ts preview",
    "test": "vitest run --coverage",
    "typecheck": "tsc",
    "check": "npm run lint && npm run typecheck && npm test",
    "demo": "node scripts/demo.ts",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamegoro/techcrema.git"
  },
  "keywords": [
    "github-action",
    "github-pages",
    "hacker-news",
    "news-aggregator",
    "rss"
  ]
}
