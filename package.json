{
  "name": "tech-catchup",
  "version": "0.1.0",
  "private": true,
  "description": "各プラットフォームで人気、かつ自分の関心に合う技術記事を毎日1ページにまとめる個人用リーダー",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "node src/collect.ts",
    "start": "node src/server.ts",
    "start:lan": "HOST=0.0.0.0 node src/server.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
